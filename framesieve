#!/usr/bin/env python3
"""Run framesieve from a clone without installing it.

`pip install -e .` gives you a real `framesieve` command and this file becomes
unnecessary. It exists so that `./framesieve ...` works immediately after a
git clone, which is how most people first try a tool.
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "src"))

from framesieve.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
